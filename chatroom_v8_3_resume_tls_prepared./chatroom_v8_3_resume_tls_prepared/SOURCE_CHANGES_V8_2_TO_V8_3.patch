+bool upload_source_matches(
+    const PendingUpload& upload,
+    std::string& error
+) {
+    std::error_code filesystem_error;
+
+    if (!std::filesystem::is_regular_file(
+            upload.source_path,
+            filesystem_error
+        )) {
+        error =
+            "upload source file is missing";
+        return false;
+    }
+
+    const std::uint64_t size =
+        static_cast<std::uint64_t>(
+            std::filesystem::file_size(
+                upload.source_path,
+                filesystem_error
+            )
+        );
+
+    if (filesystem_error) {
+        error =
+            "cannot inspect upload source size: " +
+            filesystem_error.message();
+        return false;
+    }
+
+    if (size != upload.file_size) {
+        error =
+            "upload source size changed since task was saved";
+        return false;
+    }
+
+    std::string current_sha;
+
+    if (!fileutil::sha256_file_hex(
+            upload.source_path,
+            current_sha,
+            error
+        )) {
+        return false;
+    }
+
+    if (current_sha !=
+        upload.sha256_hex) {
+        error =
+            "upload source SHA-256 changed since task was saved";
+        return false;
+    }
+
+    return true;
+}

+
+    if (!saved.empty()) {
+        std::cout
+            << "[resume] found "
+            << saved.size()
+            << " pending upload task(s) in SQLite.\n";
+    }
+
+    return start_next_queued_upload(
+        ssl,
+        state,
+        cache
+    );

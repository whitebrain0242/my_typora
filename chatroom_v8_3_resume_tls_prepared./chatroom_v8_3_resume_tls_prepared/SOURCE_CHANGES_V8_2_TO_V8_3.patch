+        if (!tlsHandshakeComplete_) {
+            driveTlsHandshake();
+            return;
+        }
+
+        if (tlsReadBlockedOnWrite_) {
+            tlsReadBlockedOnWrite_ = false;
+            handleTlsRead();
+
+            if (state_.load() !=
+                State::kConnected) {
+                return;
+            }
+        }
+
+        flushTlsOutput();
+        return;
+    }

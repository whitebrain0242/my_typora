+            statement.get()
+        ) != 0) {
+        error =
+            mysql_stmt_error_text(
+                statement.get()
+            );
+        return false;
+    }
+
+    const unsigned int field_count =
+        mysql_num_fields(
+            metadata.get()
+        );
+
+    MYSQL_FIELD* fields =
+        mysql_fetch_fields(
+            metadata.get()
+        );
+

+            buffer,
+            static_cast<int>(
+                std::min<std::size_t>(
+                    capacity,
+                    static_cast<std::size_t>(
+                        INT_MAX
+                    )
+                )
+            )
+        );
+
+    if (received > 0) {
+        return received;
+    }
+
+    const int ssl_error =
+        SSL_get_error(
+            ssl,
+            received
+        );
+
+    if (ssl_error ==
+        SSL_ERROR_ZERO_RETURN) {
+        return 0;
+    }
+
+    if (ssl_error ==
+            SSL_ERROR_WANT_READ ||
+        ssl_error ==
+            SSL_ERROR_WANT_WRITE) {
+        errno = EAGAIN;
+        return -1;
+    }
+
+    errno = EIO;

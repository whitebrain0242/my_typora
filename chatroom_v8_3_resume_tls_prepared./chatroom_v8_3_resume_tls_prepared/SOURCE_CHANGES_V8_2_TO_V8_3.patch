+        for (unsigned int index = 0;
+             index < field_count;
+             ++index) {
+            if (result_nulls[index] != 0) {
+                row.push_back(
+                    std::nullopt
+                );
+                continue;
+            }
+
+            row.emplace_back(
+                std::string(
+                    buffers[index].data(),
+                    result_lengths[index]
+                )

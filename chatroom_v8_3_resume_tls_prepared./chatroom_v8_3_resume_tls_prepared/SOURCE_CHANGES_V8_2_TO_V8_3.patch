+            " " +
+            upload.target +
+            " " +
+            encode_text_base64(
+                upload.file_name
+            ) +
+            " " +
+            std::to_string(
+                upload.file_size
+            ) +
+            " " +
+            upload.sha256_hex +
+            "\n"
+    );
+}

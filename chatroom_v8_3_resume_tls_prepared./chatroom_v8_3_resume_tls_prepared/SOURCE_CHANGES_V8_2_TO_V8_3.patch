+            << error
+            << '\n';
+        return true;
+    }
+
+    state.pending_uploads.clear();
+    state.upload_queue.clear();
+    state.active_upload_token.clear();
+
+    for (const LocalPendingUpload& local :
+         saved) {
+        PendingUpload upload =
+            pending_upload_from_local(
